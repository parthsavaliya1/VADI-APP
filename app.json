{
  "expo": {
    "name": "VADI",
    "slug": "vadi-product",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/vadi-brand-logo.png",
    "scheme": "vadiapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vadi.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocationWhenInUseUsageDescription": "VADI uses your location to pick a delivery address or share a delivery staff location when requested."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/vadi-brand-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vadi.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VADI uses your location to pick a delivery address or, when delivery staff choose Share my location, share their position with the customer.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VADI uses the microphone only when you choose voice search. Your device speech provider may process audio to turn it into search text.",
          "speechRecognitionPermission": "VADI uses speech recognition to turn your voice into product search text."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/vadi-brand-logo.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/vadi-brand-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/vadi-brand-logo.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "targetSdkVersion": 36,
            "compileSdkVersion": 37
          }
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f388db81-48ff-4df8-a155-1e55f92484c4"
      },
      "firebase": {
        "apiKey": "AIzaSyDKFb4dsMNsH7YYvZBKYjwp3mZEu_IucXA",
        "authDomain": "vadi-app-fresh.firebaseapp.com",
        "projectId": "vadi-app-fresh",
        "storageBucket": "vadi-app-fresh.firebasestorage.app",
        "messagingSenderId": "1082226902300",
        "appId": "1:1082226902300:android:3c4d7768e6eb4dcbc926d9"
      },
      "privacyPolicyUrl": "https://vadi-backend.onrender.com/privacy-policy",
      "accountDeletionUrl": "https://vadi-backend.onrender.com/account-deletion"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f388db81-48ff-4df8-a155-1e55f92484c4"
    },
    "owner": "vadi-app"
  }
}
